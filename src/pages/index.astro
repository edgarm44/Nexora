---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Nexora — Apprendre Python">
  <div class="hero">
    <div class="hero-lueur"></div>
    <div>
      <span class="commentaire">bienvenue</span>
      <h1>Apprends Python, une ligne à la fois.</h1>
      <p class="lede">
        Des séances de 5 à 10 minutes, depuis ton tout premier print() jusqu'au
        jour où tu publies ton propre site. Pas de jargon : on commence directement
        par le niveau Débutant.
      </p>
      <div class="actions">
        <a class="btn" href={`${base}lecons/`}>Commencer les exercices</a>
        <a class="btn-ghost" href={`${base}compte/`}>Mon compte</a>
      </div>

      <div class="carte accueil-progres" id="accueil-progres" style="display:none; margin-top: 1.5rem;">
        <span class="commentaire">ta progression</span>
        <p id="accueil-progres-texte" style="margin: 0.5rem 0 0; color: var(--ink-dim);"></p>
        <div class="progres-barre"><span id="accueil-progres-remplissage" style="width: 0%;"></span></div>
        <div class="actions" style="margin-top: 1rem;">
          <a class="btn-ghost" href={`${base}lecons/`}>Continuer mes exercices</a>
        </div>
      </div>
    </div>

    <div class="terminal" aria-hidden="true">
      <div class="terminal-barre">
        <span>bonjour.py</span>
      </div>
      <div class="terminal-corps" id="hero-terminal"></div>
    </div>
  </div>
</Base>

<script>
  const ORDRE = ["debutant", "intermediaire", "confirme", "expert", "web", "algorithmes", "donnees", "projet"];
  const TOTAUX: Record<string, number> = { debutant: 8, intermediaire: 9, confirme: 9, expert: 10, web: 8, algorithmes: 9, donnees: 10, projet: 9 };

  function progres(niveauId: string): string[] {
    try {
      return JSON.parse(localStorage.getItem(`nexora_progres_${niveauId}`) ?? "[]");
    } catch {
      return [];
    }
  }

  const totalGeneral = Object.values(TOTAUX).reduce((a, b) => a + b, 0);
  const faitGeneral = ORDRE.reduce((acc, id) => acc + Math.min(progres(id).length, TOTAUX[id]), 0);

  if (faitGeneral > 0) {
    const pourcentage = Math.round((faitGeneral / totalGeneral) * 100);

    const bloc = document.getElementById("accueil-progres")!;
    const texte = document.getElementById("accueil-progres-texte")!;
    const remplissage = document.getElementById("accueil-progres-remplissage")!;

    bloc.style.display = "block";
    if (faitGeneral >= totalGeneral) {
      texte.textContent = `Les ${totalGeneral} exercices sont terminés. Bravo !`;
    } else {
      texte.textContent = `${faitGeneral} exercice${faitGeneral > 1 ? "s" : ""} sur ${totalGeneral} terminé${faitGeneral > 1 ? "s" : ""} (${pourcentage}%).`;
    }
    remplissage.style.width = `${pourcentage}%`;
  }

  const lignes = [
    { num: 1, texte: 'nom = "toi"' },
    { num: 2, texte: 'print("Salut,", nom)' },
    { num: 3, texte: "" },
    { num: 4, texte: "# et ça continue..." },
  ];

  const el = document.getElementById("hero-terminal")!;
  const reduitMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function ligneHTML(num: number, texte: string) {
    const row = document.createElement("div");
    row.className = "terminal-ligne";
    const n = document.createElement("span");
    n.className = "num";
    n.textContent = String(num);
    const code = document.createElement("span");
    code.textContent = texte;
    row.append(n, code);
    return { row, code };
  }

  if (reduitMotion) {
    lignes.forEach(({ num, texte }) => el.appendChild(ligneHTML(num, texte).row));
  } else {
    let i = 0;
    function suivante() {
      if (i >= lignes.length) return;
      const { row, code } = ligneHTML(lignes[i].num, "");
      el.appendChild(row);
      const texte = lignes[i].texte;
      let c = 0;
      const curseur = document.createElement("span");
      curseur.className = "curseur";
      row.appendChild(curseur);
      const interval = setInterval(() => {
        code.textContent = texte.slice(0, c + 1);
        c++;
        if (c >= texte.length) {
          clearInterval(interval);
          curseur.remove();
          i++;
          setTimeout(suivante, 220);
        }
      }, 28);
    }
    suivante();
  }
</script>
