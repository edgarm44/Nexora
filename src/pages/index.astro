---
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Nexora — Apprendre Python">
  <span class="tag">Python · depuis zéro</span>
  <h1>Nexora</h1>
  <p>Apprends à coder en Python depuis la base, par séances courtes de 5 à 10 minutes. Jusqu'à publier ton propre site, tout seul.</p>
  <div>
    <a class="btn" href={`${base}test/`}>Commencer le test de positionnement</a>
    <a class="btn-ghost" href={`${base}lecons/`}>Voir les leçons</a>
  </div>
</Base>
