---
import Base from "../../layouts/Base.astro";
---
<Base title="Nexora — Anglais" description="Nexora : un QCM gratuit pour réviser les bases de l'anglais, niveau collège. Vocabulaire, grammaire simple, sans jargon.">
  <span class="commentaire">anglais</span>
  <h1>Les bases de l'anglais</h1>
  <p class="lede">Un petit détour hors Python : dix questions pour réviser le vocabulaire et la grammaire de base, niveau collège. Même principe que les exercices Python : une explication courte, puis la question.</p>

  <div class="carte" id="exo-card">
    <div class="progression" id="exo-progress"></div>
    <div id="exo-body"></div>
  </div>
</Base>

<script>
  import { initExercices, type Unite } from "../../lib/exercices";

  const UNITES: Unite[] = [
    {
      id: "u1",
      titre: "Se présenter",
      explication: "En anglais, pour dire \"je m'appelle\", on utilise le verbe to be (être) : My name is... ou I am... Les deux sont corrects pour se présenter.",
      exemple: ["My name is Léa.\nI am Léa."],
      consigne: "Comment dit-on \"Je m'appelle Tom\" en anglais ?",
      type: "qcm",
      options: ["My name is Tom.", "I has Tom.", "Me call Tom.", "Tom am I."],
      bonneOption: 0,
      explicationReponse: "\"My name is Tom\" utilise is, la forme du verbe to be pour \"il/elle/ça\" — ici le mot name (le nom).",
    },
    {
      id: "u2",
      titre: "Les pronoms personnels",
      explication: "Les pronoms personnels en anglais sont : I (je), you (tu/vous), he (il), she (elle), it (ça, pour un objet ou animal), we (nous), they (ils/elles). Contrairement au français, \"you\" sert aussi bien pour le tutoiement que le vouvoiement.",
      exemple: ["He is tall.\nShe is funny."],
      consigne: "Quel pronom utilise-t-on pour parler d'un chat (\"il\" en français, mais un animal) ?",
      type: "qcm",
      options: ["It", "He", "You", "They"],
      bonneOption: 0,
      explicationReponse: "On utilise \"it\" pour les objets et, en général, pour les animaux dont on ne connaît pas le sexe ou que l'on ne personnifie pas.",
    },
    {
      id: "u3",
      titre: "Le verbe to be au présent",
      explication: "to be (être) se conjugue ainsi au présent : I am, you are, he/she/it is, we are, they are. C'est un des verbes les plus utilisés en anglais, et il est irrégulier — il faut le connaître par cœur.",
      exemple: ["I am happy.\nThey are late."],
      consigne: "Complète : \"She ___ a teacher.\"",
      type: "qcm",
      options: ["is", "am", "are", "be"],
      bonneOption: 0,
      explicationReponse: "\"She\" (elle) se conjugue avec \"is\", comme he et it.",
    },
    {
      id: "u4",
      titre: "Le verbe to have",
      explication: "to have (avoir) se conjugue : I have, you have, he/she/it has, we have, they have. Seule la 3e personne du singulier (he/she/it) change, avec \"has\".",
      exemple: ["I have a dog.\nHe has a cat."],
      consigne: "Complète : \"I ___ two brothers.\"",
      type: "qcm",
      options: ["have", "has", "am", "is"],
      bonneOption: 0,
      explicationReponse: "\"I\" se conjugue toujours avec \"have\", jamais \"has\" (réservé à he/she/it).",
    },
    {
      id: "u5",
      titre: "Les mots interrogatifs",
      explication: "Pour poser une question, l'anglais utilise des mots comme What (quoi/quel), Where (où), When (quand), Who (qui), Why (pourquoi), How (comment).",
      exemple: ["What is your name?\nWhere do you live?"],
      consigne: "Quel mot utiliser pour demander l'heure, \"___ time is it?\" ?",
      type: "qcm",
      options: ["What", "Who", "Why", "Where"],
      bonneOption: 0,
      explicationReponse: "\"What time is it?\" est la façon standard de demander l'heure en anglais.",
    },
    {
      id: "u6",
      titre: "Les nombres",
      explication: "Les nombres de base : one, two, three, four, five, six, seven, eight, nine, ten. Attention aux pièges d'orthographe, par exemple \"four\" (4) ne s'écrit pas comme \"for\" (pour), même si ça se prononce pareil.",
      exemple: ["I have three apples."],
      consigne: "Comment écrit-on le nombre 8 en anglais ?",
      type: "qcm",
      options: ["eight", "eigth", "eighth", "ate"],
      bonneOption: 0,
      explicationReponse: "\"Eight\" (8) se prononce comme \"ate\", mais ne s'écrit pas pareil — un piège fréquent.",
    },
    {
      id: "u7",
      titre: "Le pluriel des noms",
      explication: "En général, on ajoute juste -s pour former le pluriel : a cat → two cats. Mais certains mots sont irréguliers, comme child → children, ou man → men.",
      exemple: ["One book, two books.\nOne child, two children."],
      consigne: "Quel est le pluriel de \"child\" (enfant) ?",
      type: "qcm",
      options: ["children", "childs", "childes", "childrens"],
      bonneOption: 0,
      explicationReponse: "\"Child\" est irrégulier : son pluriel est \"children\", pas \"childs\".",
    },
    {
      id: "u8",
      titre: "Vocabulaire : les couleurs",
      explication: "Les couleurs de base : red (rouge), blue (bleu), green (vert), yellow (jaune), black (noir), white (blanc), orange (orange), purple (violet).",
      exemple: ["The sky is blue."],
      consigne: "Comment dit-on \"vert\" en anglais ?",
      type: "qcm",
      options: ["green", "grey", "great", "glean"],
      bonneOption: 0,
      explicationReponse: "\"Green\" veut dire vert. \"Grey\" veut dire gris — un piège fréquent entre les deux.",
    },
    {
      id: "u9",
      titre: "Present simple vs present continuous",
      explication: "Le present simple décrit une habitude (I play football every week). Le present continuous (be + verbe en -ing) décrit une action en train de se passer maintenant (I am playing football right now).",
      exemple: ["I play tennis on Sundays.\nI am playing tennis right now."],
      consigne: "Comment dire \"Je suis en train de manger\" (là, maintenant) ?",
      type: "qcm",
      options: ["I am eating.", "I eat.", "I eats.", "I am eat."],
      bonneOption: 0,
      explicationReponse: "Une action en cours se forme avec \"am/is/are\" + le verbe en -ing : \"I am eating\".",
    },
    {
      id: "u10",
      titre: "Dire l'heure et les jours",
      explication: "Les jours de la semaine commencent toujours par une majuscule en anglais, contrairement au français : Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday.",
      exemple: ["See you on Monday!"],
      consigne: "Lequel de ces mots est correctement écrit ?",
      type: "qcm",
      options: ["Friday", "friday", "Fryday", "Fridai"],
      bonneOption: 0,
      explicationReponse: "Les jours de la semaine prennent toujours une majuscule en anglais : \"Friday\", jamais \"friday\".",
    },
  ];

  initExercices({
    unites: UNITES,
    cleProgres: "nexora_progres_anglais",
    corpsId: "exo-body",
    progressionId: "exo-progress",
    base: import.meta.env.BASE_URL,
    titreFin: "QCM d'anglais terminé",
    texteFin: "Les dix questions sont faites. Tu peux les refaire à tout moment pour réviser.",
    retourHref: `${import.meta.env.BASE_URL}anglais/`,
    hrefRevoir: `${import.meta.env.BASE_URL}anglais/`,
  });
</script>
