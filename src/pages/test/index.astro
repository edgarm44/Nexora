---
import Base from "../../layouts/Base.astro";
---
<Base title="Nexora — Test de positionnement">
  <span class="commentaire">étape 1</span>
  <h1>Où en es-tu ?</h1>
  <p class="lede">Quelques questions pour trouver ton point de départ. Dès qu'une réponse te résiste, on s'arrête là : pas besoin d'aller plus loin pour aujourd'hui.</p>

  <div class="carte" id="quiz-card">
    <div class="progression" id="quiz-progress"></div>
    <div id="quiz-body"></div>
  </div>
</Base>

<script>
  type Niveau = "debutant" | "intermediaire" | "confirme" | "expert";

  interface Question {
    enonce: string;
    code?: string;
    options: string[];
    bonne: number;
    explication: string;
  }

  interface Palier {
    id: Niveau;
    label: string;
    intro: string;
    questions: Question[];
  }

  const NIVEAUX: Palier[] = [
    {
      id: "debutant",
      label: "Débutant",
      intro: "On commence simple : afficher du texte et ranger des valeurs.",
      questions: [
        {
          enonce: "Que va afficher ce programme ?",
          code: 'print("Bonjour")',
          options: ["Bonjour", '"Bonjour"', "Une erreur", "Rien"],
          bonne: 0,
          explication: "print() affiche le contenu sans les guillemets : ils servent juste à délimiter le texte dans le code.",
        },
        {
          enonce: "Après ces deux lignes, que vaut x ?",
          code: "x = 3\nx = x + 2",
          options: ["3", "2", "5", "Une erreur"],
          bonne: 2,
          explication: "La deuxième ligne relit la valeur actuelle de x (3), lui ajoute 2, puis range le résultat dans x.",
        },
      ],
    },
    {
      id: "intermediaire",
      label: "Intermédiaire",
      intro: "On monte d'un cran : des décisions et des répétitions.",
      questions: [
        {
          enonce: "Que va afficher ce programme ?",
          code: "for i in range(3):\n    print(i)",
          options: ["0 1 2", "1 2 3", "3", "0 1 2 3"],
          bonne: 0,
          explication: "range(3) parcourt 0, 1 et 2 : Python commence à compter à partir de 0.",
        },
        {
          enonce: "Que va afficher ce programme ?",
          code: 'x = 7\nif x > 5:\n    print("grand")\nelse:\n    print("petit")',
          options: ["grand", "petit", "Une erreur", "Rien"],
          bonne: 0,
          explication: "7 est supérieur à 5, donc la condition du if est vraie : seul le bloc du if s'exécute.",
        },
      ],
    },
    {
      id: "confirme",
      label: "Confirmé",
      intro: "Des briques plus solides : fonctions et structures de données.",
      questions: [
        {
          enonce: "Que renvoie l'appel carre(4) ?",
          code: "def carre(n):\n    return n * n",
          options: ["8", "16", "4", "Une erreur"],
          bonne: 1,
          explication: "La fonction multiplie n par lui-même : 4 × 4 = 16.",
        },
        {
          enonce: "Que va afficher ce programme ?",
          code: 'fruits = ["pomme", "poire", "kiwi"]\nprint(fruits[1])',
          options: ["pomme", "poire", "kiwi", "Une erreur"],
          bonne: 1,
          explication: "Dans une liste, le premier élément est à l'indice 0 : l'indice 1 pointe donc sur le deuxième, poire.",
        },
      ],
    },
    {
      id: "expert",
      label: "Expert",
      intro: "Les notions qui préparent à construire un vrai projet.",
      questions: [
        {
          enonce: "Quel mot-clé permet de capturer une exception en Python ?",
          options: ["catch", "except", "rescue", "error"],
          bonne: 1,
          explication: "Python utilise try / except, contrairement à d'autres langages qui utilisent try / catch.",
        },
        {
          enonce: "Que fait la ligne import math ?",
          options: [
            "Elle importe le module math pour utiliser ses fonctions",
            "Elle crée une variable nommée math",
            "Elle supprime le module math",
            "Elle affiche la documentation de Python",
          ],
          bonne: 0,
          explication: "import rend accessibles les fonctions d'un module, ici des fonctions mathématiques comme sqrt ou pi.",
        },
      ],
    },
  ];

  const base = import.meta.env.BASE_URL;
  const body = document.getElementById("quiz-body")!;
  const progress = document.getElementById("quiz-progress")!;

  type Step =
    | { kind: "gate" }
    | { kind: "intro"; niveauIndex: number }
    | { kind: "question"; niveauIndex: number; questionIndex: number };

  const steps: Step[] = [{ kind: "gate" }];
  for (let n = 0; n < NIVEAUX.length; n++) {
    steps.push({ kind: "intro", niveauIndex: n });
    for (let q = 0; q < NIVEAUX[n].questions.length; q++) {
      steps.push({ kind: "question", niveauIndex: n, questionIndex: q });
    }
  }

  let current = 0;
  let niveauAtteint: Niveau = "debutant";

  function renderProgress() {
    progress.innerHTML = "";
    for (let i = 0; i < steps.length; i++) {
      const span = document.createElement("span");
      if (i < current) span.className = "fait";
      else if (i === current) span.className = "courant";
      progress.appendChild(span);
    }
  }

  function codeBlockHTML(code: string) {
    const lignes = code.split("\n");
    return `
      <div class="terminal" style="margin-bottom: 1.25rem;">
        <div class="terminal-barre"><span>python</span></div>
        <div class="terminal-corps">
          ${lignes
            .map(
              (l, i) =>
                `<div class="terminal-ligne"><span class="num">${i + 1}</span><span>${l.replace(/</g, "&lt;")}</span></div>`
            )
            .join("")}
        </div>
      </div>
    `;
  }

  function avancer() {
    current++;
    renderProgress();
    renderStep();
  }

  function finirAu(niveau: Niveau) {
    niveauAtteint = niveau;
    localStorage.setItem("nexora_niveau", niveau);
    renderResult();
  }

  function renderResult(dejaEnregistre = false) {
    progress.innerHTML = "";
    const label = NIVEAUX.find((n) => n.id === niveauAtteint)?.label ?? "Débutant";
    body.innerHTML = `
      <div class="resultat">
        <span class="commentaire">${dejaEnregistre ? "déjà fait" : "résultat"}</span>
        <h2>Ton niveau de départ : <span class="niveau-mot">${label}</span></h2>
        <p style="color: var(--ink-dim);">${dejaEnregistre ? "Tu as déjà passé ce test." : "On a préparé des exercices adaptés à ce niveau."} Direction tes exercices.</p>
        <div class="actions">
          <a class="btn" href="${base}lecons/">Voir mes exercices</a>
        </div>
      </div>
    `;
  }

  function renderGate() {
    body.innerHTML = `
      <p class="question">As-tu déjà écrit du code avant, en Python ou dans un autre langage ?</p>
      <div class="options">
        <button class="option" data-answer="oui">Oui, un peu</button>
        <button class="option" data-answer="non">Non, jamais</button>
      </div>
    `;
    body.querySelectorAll<HTMLButtonElement>(".option").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (btn.dataset.answer === "non") {
          finirAu("debutant");
        } else {
          avancer();
        }
      });
    });
  }

  function renderIntro(niveauIndex: number) {
    const niveau = NIVEAUX[niveauIndex];
    body.innerHTML = `
      <span class="commentaire">niveau ${niveauIndex + 1} sur ${NIVEAUX.length}</span>
      <h2 style="margin-top: 0.2rem;">${niveau.label}</h2>
      <p style="color: var(--ink-dim); max-width: 50ch;">${niveau.intro}</p>
      <div class="actions"><button class="btn" id="intro-continuer" type="button">Je me lance</button></div>
    `;
    document.getElementById("intro-continuer")!.addEventListener("click", avancer);
  }

  function renderQuestion(niveauIndex: number, questionIndex: number) {
    const niveau = NIVEAUX[niveauIndex];
    const q = niveau.questions[questionIndex];

    body.innerHTML = `
      <span class="commentaire">${niveau.label.toLowerCase()} · question ${questionIndex + 1} sur ${niveau.questions.length}</span>
      <p class="question">${q.enonce}</p>
      ${q.code ? codeBlockHTML(q.code) : ""}
      <div class="options">
        ${q.options
          .map((opt, i) => `<button class="option" data-index="${i}">${opt}</button>`)
          .join("")}
      </div>
      <div id="suite"></div>
    `;

    const buttons = body.querySelectorAll<HTMLButtonElement>(".option");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const choisi = Number(btn.dataset.index);
        buttons.forEach((b) => (b.disabled = true));

        if (choisi === q.bonne) {
          btn.classList.add("bonne");
        } else {
          btn.classList.add("mauvaise");
          buttons[q.bonne].classList.add("bonne");
        }

        const correct = choisi === q.bonne;
        const suite = document.getElementById("suite")!;
        suite.innerHTML = `
          <p class="retour ${correct ? "ok" : "ko"}" style="margin-top: 1.1rem;">
            ${correct ? "Bonne réponse. " : "Pas cette fois. "}${q.explication}
          </p>
          <div class="actions"><button class="btn" id="question-continuer" type="button">Continuer</button></div>
        `;

        document.getElementById("question-continuer")!.addEventListener("click", () => {
          const dernierQuestionDuNiveau = questionIndex === niveau.questions.length - 1;

          if (!correct) {
            const niveauFinal = niveauIndex === 0 ? "debutant" : NIVEAUX[niveauIndex - 1].id;
            finirAu(niveauFinal);
            return;
          }

          if (dernierQuestionDuNiveau && niveauIndex === NIVEAUX.length - 1) {
            finirAu(niveau.id);
            return;
          }

          avancer();
        });
      });
    });
  }

  function renderStep() {
    const step = steps[current];
    if (!step) {
      finirAu(NIVEAUX[NIVEAUX.length - 1].id);
      return;
    }
    if (step.kind === "gate") renderGate();
    else if (step.kind === "intro") renderIntro(step.niveauIndex);
    else renderQuestion(step.niveauIndex, step.questionIndex);
  }

  const niveauDejaEnregistre = localStorage.getItem("nexora_niveau") as Niveau | null;
  if (niveauDejaEnregistre) {
    niveauAtteint = niveauDejaEnregistre;
    renderResult(true);
  } else {
    renderProgress();
    renderStep();
  }
</script>
