---
import Base from "../../../layouts/Base.astro";
---
<Base title="Nexora — Confirmé">
  <span class="commentaire">confirmé</span>
  <h1>Fonctions, listes et dictionnaires</h1>
  <p class="lede">Huit notions. Plusieurs se font dans un terminal qui exécute vraiment ton code.</p>

  <div class="carte" id="exo-card">
    <div class="progression" id="exo-progress"></div>
    <div id="exo-body"></div>
  </div>
</Base>

<script is:inline src="https://cdn.jsdelivr.net/pyodide/v0.27.6/full/pyodide.js"></script>
<script>
  import { initExercices, type Unite } from "../../../lib/exercices";

  const UNITES: Unite[] = [
    {
      id: "u1",
      titre: "Une fonction, une machine réutilisable",
      explication:
        "def donne un nom à un bloc de code. return renvoie un résultat à qui a appelé la fonction, sans l'afficher directement — il faut un print() séparé si on veut le voir à l'écran.",
      exemple: ["def carre(n):\n    return n * n", "print(carre(4))"],
      consigne: "Que renvoie l'appel double(5) ?",
      code: ["def double(n):\n    return n * 2"],
      type: "qcm",
      options: ["5", "10", "25", "Une erreur"],
      bonneOption: 1,
    },
    {
      id: "u2",
      titre: "Écrire sa première fonction, dans un vrai terminal",
      explication:
        "Ici, le code que tu écris est vraiment exécuté par Python, dans ton navigateur. Complète la fonction puis appuie sur Exécuter.",
      exemple: ['def saluer(nom):\n    return "Bonjour " + nom'],
      consigne: "Complète la fonction triple pour qu'elle renvoie n multiplié par 3, puis affiche triple(4) avec print().",
      type: "code",
      codeDepart: "def triple(n):\n    return ____\n\nprint(triple(4))",
      sortieAttendue: /^12$/,
      indiceCode: "Remplace ____ par n * 3, puis vérifie que print(triple(4)) est bien présent.",
    },
    {
      id: "u3",
      titre: "Une liste range plusieurs valeurs",
      explication:
        "Une liste se note entre crochets [ ]. Le premier élément est à l'indice 0, le deuxième à l'indice 1, et ainsi de suite — c'est la même logique que range() vue au niveau précédent.",
      exemple: ['fruits = ["pomme", "poire", "kiwi"]', "print(fruits[1])"],
      consigne: "Que va afficher ce programme ?",
      code: ["notes = [12, 15, 8, 17]", "print(notes[2])"],
      type: "qcm",
      options: ["12", "15", "8", "17"],
      bonneOption: 2,
    },
    {
      id: "u4",
      titre: "Parcourir une liste avec une boucle",
      explication:
        "On peut combiner for et une liste pour traiter chaque élément un par un, sans avoir besoin de connaître sa position — contrairement à range(), qui donne des positions.",
      exemple: ['for fruit in ["pomme", "poire"]:\n    print(fruit)'],
      consigne: "Écris dans le terminal une boucle qui affiche chaque nombre de la liste [2, 4, 6] avec print().",
      type: "code",
      codeDepart: "nombres = [2, 4, 6]\n____________",
      sortieAttendue: /^2\s*4\s*6$/,
      indiceCode: "Une boucle for nombre in nombres: suivie d'une ligne indentée avec print(nombre).",
    },
    {
      id: "u5",
      titre: "Un dictionnaire associe une clé à une valeur",
      explication:
        "Un dictionnaire se note entre accolades { }. Chaque valeur a un nom (la clé) plutôt qu'une simple position, ce qui rend le code plus lisible qu'une liste quand les données ont un sens précis.",
      exemple: ['eleve = {"nom": "Léa", "age": 13}', 'print(eleve["age"])'],
      consigne: 'Complète pour accéder à la valeur associée à la clé "ville".',
      code: ['infos = {"ville": "Lyon", "pays": "France"}', "print(infos[____________])"],
      type: "completer",
      reponsesValides: /^"ville"$/,
      placeholder: '"ville"',
      indiceErreur: 'Il faut le nom exact de la clé, entre guillemets : "ville".',
    },
    {
      id: "u6",
      titre: "Faire grandir une liste avec .append()",
      explication:
        "Une liste peut grandir après sa création. .append(valeur) ajoute un élément à la fin de la liste — pratique pour construire une liste au fil d'un programme plutôt que tout écrire d'un coup.",
      exemple: ['fruits = ["pomme"]\nfruits.append("poire")\nprint(fruits)'],
      consigne: "Crée une liste vide notes = [], ajoute 12 puis 15 avec .append(), puis affiche la liste.",
      type: "code",
      codeDepart: "notes = []\n____________\nprint(notes)",
      sortieAttendue: /^\[12,\s*15\]$/,
      indiceCode: "Deux lignes : notes.append(12) puis notes.append(15), avant le print(notes).",
    },
    {
      id: "u7",
      titre: "Le texte a aussi ses outils",
      explication:
        "len() donne la longueur d'un texte ou d'une liste. .upper() met en majuscules, .lower() en minuscules. Ce sont des méthodes : elles se collent après la valeur avec un point.",
      exemple: ['mot = "bonjour"\nprint(len(mot))\nprint(mot.upper())'],
      consigne: "Que va afficher ce programme ?",
      code: ['prenom = "Léa"\nprint(prenom.upper())'],
      type: "qcm",
      options: ["Léa", "LÉA", "léa", "Une erreur"],
      bonneOption: 1,
    },
    {
      id: "u8",
      titre: "Parcourir un dictionnaire",
      explication:
        "Un dictionnaire se parcourt aussi avec for, en utilisant .items() pour récupérer à la fois la clé et la valeur à chaque tour.",
      exemple: ['eleve = {"nom": "Léa", "age": 13}\nfor cle, valeur in eleve.items():\n    print(cle, valeur)'],
      consigne: "Que va afficher ce programme ?",
      code: ['notes = {"maths": 15, "svt": 12}\nfor matiere, note in notes.items():\n    print(matiere, note)'],
      type: "qcm",
      options: [
        "Chaque matière suivie de sa note, une ligne par matière",
        "Seulement les noms des matières",
        "Seulement les notes",
        "Une erreur, .items() n'existe pas",
      ],
      bonneOption: 0,
    },
  ];

  initExercices({
    unites: UNITES,
    cleProgres: "nexora_progres_confirme",
    corpsId: "exo-body",
    progressionId: "exo-progress",
    base: import.meta.env.BASE_URL,
    titreFin: "Niveau confirmé terminé",
    texteFin: "Les huit exercices sont faits. Le niveau expert vient de se débloquer.",
    retourHref: `${import.meta.env.BASE_URL}lecons/`,
  });
</script>
