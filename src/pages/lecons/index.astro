---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;

const niveaux = [
  { id: "debutant", glyphe: ">", nom: "Débutant", desc: "Afficher un message, utiliser des variables.", href: `${base}lecons/debutant/`, pret: true },
  { id: "intermediaire", glyphe: ">_", nom: "Intermédiaire", desc: "Conditions, boucles, logique de base.", href: `${base}lecons/intermediaire/`, pret: true },
  { id: "confirme", glyphe: "{ }", nom: "Confirmé", desc: "Fonctions, listes, dictionnaires, un vrai terminal.", href: `${base}lecons/confirme/`, pret: true },
  { id: "expert", glyphe: "#!", nom: "Expert", desc: "Classes, exceptions, modules, un aperçu du HTML.", href: `${base}lecons/expert/`, pret: true },
];
---
<Base title="Nexora — Exercices">
  <span class="commentaire">parcours</span>
  <h1>Les exercices</h1>
  <p class="lede">Pas de longs cours à lire : chaque notion tient en quelques phrases, suivies d'un exercice. Quatre niveaux, dans l'ordre.</p>

  <div class="grille-niveaux" id="niveaux">
    {niveaux.map((n) => (
      n.pret ? (
        <a class="carte-niveau" data-niveau={n.id} href={n.href}>
          <span class="glyphe">{n.glyphe}</span>
          <h3>{n.nom}</h3>
          <p>{n.desc}</p>
          <span class="suite">Commencer</span>
        </a>
      ) : (
        <div class="carte-niveau verrouille" data-niveau={n.id}>
          <span class="glyphe">{n.glyphe}</span>
          <h3>{n.nom}</h3>
          <p>{n.desc}</p>
          <span class="suite">Bientôt</span>
        </div>
      )
    ))}
  </div>
</Base>

<script>
  const TOTAUX_PAR_NIVEAU: Record<string, number> = { debutant: 4, intermediaire: 5, confirme: 5, expert: 6 };

  function progres(niveauId: string): string[] {
    try {
      return JSON.parse(localStorage.getItem(`nexora_progres_${niveauId}`) ?? "[]");
    } catch {
      return [];
    }
  }

  const niveauTrouve = localStorage.getItem("nexora_niveau");

  document.querySelectorAll<HTMLElement>(".carte-niveau[data-niveau]").forEach((carte) => {
    const id = carte.getAttribute("data-niveau")!;
    const total = TOTAUX_PAR_NIVEAU[id];
    const fait = total ? progres(id).length : 0;

    if (id === niveauTrouve) carte.classList.add("actif");

    if (total && fait > 0) {
      const pastille = document.createElement("span");
      pastille.className = "pastille";
      pastille.textContent = fait >= total ? "terminé" : `${fait}/${total}`;
      carte.appendChild(pastille);
    } else if (id === niveauTrouve) {
      const pastille = document.createElement("span");
      pastille.className = "pastille";
      pastille.textContent = "ton niveau";
      carte.appendChild(pastille);
    }
  });
</script>
