---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;

const niveaux = [
  { id: "debutant", glyphe: ">", nom: "Débutant", desc: "Afficher un message, utiliser des variables.", href: `${base}lecons/debutant/` },
  { id: "intermediaire", glyphe: ">_", nom: "Intermédiaire", desc: "Conditions, boucles, logique de base.", href: `${base}lecons/intermediaire/` },
  { id: "confirme", glyphe: "{ }", nom: "Confirmé", desc: "Fonctions, listes, dictionnaires, un vrai terminal.", href: `${base}lecons/confirme/` },
  { id: "expert", glyphe: "#!", nom: "Expert", desc: "Classes, exceptions, modules, un aperçu du HTML.", href: `${base}lecons/expert/` },
  { id: "web", glyphe: "</>", nom: "Maître", desc: "Construire une vraie page HTML, avec aperçu en direct.", href: `${base}lecons/web/` },
  { id: "algorithmes", glyphe: "ƒ(x)", nom: "Algorithmes", desc: "Compréhensions, lambda, map/filter, récursivité, tri personnalisé.", href: `${base}lecons/algorithmes/` },
  { id: "donnees", glyphe: "{...}", nom: "Données", desc: "Tuples, ensembles, formatage de texte, JSON.", href: `${base}lecons/donnees/` },
  { id: "projet", glyphe: "*", nom: "Projet", desc: "Générateurs, gestion complète des erreurs, mini-projet final.", href: `${base}lecons/projet/` },
];
---
<Base title="Nexora — Exercices">
  <span class="commentaire">parcours</span>
  <h1>Les exercices</h1>
  <p class="lede">Pas de longs cours à lire : chaque notion tient en quelques phrases, suivies d'un exercice. Huit niveaux, dans l'ordre : chacun se débloque en terminant le précédent.</p>

  <div class="carte" id="sans-test" style="display:none; margin-bottom: 1.5rem;">
    <span class="commentaire">avant de commencer</span>
    <p style="margin: 0 0 1rem; color: var(--ink-dim);">Passe d'abord le test de positionnement pour débloquer ton premier niveau.</p>
    <div class="actions"><a class="btn" href={`${base}test/`}>Faire le test</a></div>
  </div>

  <div class="grille-niveaux" id="niveaux">
    {niveaux.map((n) => (
      <a class="carte-niveau" data-niveau={n.id} data-href={n.href} href={n.href}>
        <span class="glyphe">{n.glyphe}</span>
        <h3>{n.nom}</h3>
        <p>{n.desc}</p>
        <span class="suite" data-suite>Verrouillé</span>
      </a>
    ))}
  </div>

  <div class="carte" id="sauvegarde" style="margin-top: 2rem;">
    <span class="commentaire">pas de compte</span>
    <p style="margin: 0.5rem 0 1rem; color: var(--ink-dim);">Ta progression est gardée uniquement dans ce navigateur. Si tu changes d'appareil, ou si tu veux faire une copie de sécurité, exporte-la dans un fichier.</p>
    <div class="actions">
      <button class="btn-ghost" id="btn-exporter" type="button">Exporter ma progression</button>
      <label class="btn-ghost" for="champ-import" style="cursor: pointer;">Importer une sauvegarde</label>
      <input type="file" id="champ-import" accept=".json,application/json" style="display:none;" />
    </div>
    <p class="retour" id="retour-sauvegarde" style="margin-top: 0.8rem;"></p>
  </div>
</Base>

<script>
  const ORDRE = ["debutant", "intermediaire", "confirme", "expert", "web", "algorithmes", "donnees", "projet"];
  const TOTAUX_PAR_NIVEAU: Record<string, number> = { debutant: 7, intermediaire: 8, confirme: 8, expert: 9, web: 7, algorithmes: 8, donnees: 8, projet: 8 };

  function progres(niveauId: string): string[] {
    try {
      return JSON.parse(localStorage.getItem(`nexora_progres_${niveauId}`) ?? "[]");
    } catch {
      return [];
    }
  }

  function estComplet(niveauId: string): boolean {
    const total = TOTAUX_PAR_NIVEAU[niveauId];
    return total ? progres(niveauId).length >= total : false;
  }

  const niveauTrouve = localStorage.getItem("nexora_niveau");
  const rangTrouve = niveauTrouve ? ORDRE.indexOf(niveauTrouve) : -1;

  if (!niveauTrouve) {
    document.getElementById("sans-test")!.style.display = "block";
  }

  document.querySelectorAll<HTMLAnchorElement>(".carte-niveau[data-niveau]").forEach((carte) => {
    const id = carte.getAttribute("data-niveau")!;
    const rang = ORDRE.indexOf(id);
    const total = TOTAUX_PAR_NIVEAU[id];
    const fait = progres(id).length;

    const precedentOk = rang === 0 || estComplet(ORDRE[rang - 1]);
    const debloque = rangTrouve >= 0 && (rang <= rangTrouve || precedentOk);

    const suite = carte.querySelector("[data-suite]")!;

    if (!debloque) {
      carte.classList.add("verrouille");
      carte.removeAttribute("href");
      carte.addEventListener("click", (e) => e.preventDefault());
      suite.textContent = rang === 0 ? "Fais le test" : "Verrouillé";
      return;
    }

    carte.setAttribute("href", carte.dataset.href!);

    if (id === niveauTrouve) carte.classList.add("actif");

    if (fait >= total) {
      suite.textContent = "Revoir";
      const pastille = document.createElement("span");
      pastille.className = "pastille";
      pastille.textContent = "terminé";
      carte.appendChild(pastille);
    } else if (fait > 0) {
      suite.textContent = "Continuer";
      const pastille = document.createElement("span");
      pastille.className = "pastille";
      pastille.textContent = `${fait}/${total}`;
      carte.appendChild(pastille);
    } else {
      suite.textContent = "Commencer";
      if (id === niveauTrouve) {
        const pastille = document.createElement("span");
        pastille.className = "pastille";
        pastille.textContent = "ton niveau";
        carte.appendChild(pastille);
      }
    }
  });

  // Export / import de la progression (pas de compte = tout est dans ce navigateur)
  const retourSauvegarde = document.getElementById("retour-sauvegarde")!;

  document.getElementById("btn-exporter")!.addEventListener("click", () => {
    const donnees: Record<string, unknown> = {
      nexora_export: true,
      date: new Date().toISOString(),
      niveau: localStorage.getItem("nexora_niveau"),
      progres: Object.fromEntries(ORDRE.map((id) => [id, progres(id)])),
    };
    const blob = new Blob([JSON.stringify(donnees, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const lien = document.createElement("a");
    lien.href = url;
    lien.download = "nexora-progression.json";
    document.body.appendChild(lien);
    lien.click();
    lien.remove();
    URL.revokeObjectURL(url);
    retourSauvegarde.textContent = "Fichier téléchargé.";
    retourSauvegarde.className = "retour ok";
  });

  document.getElementById("champ-import")!.addEventListener("change", (e) => {
    const fichier = (e.target as HTMLInputElement).files?.[0];
    if (!fichier) return;
    const lecteur = new FileReader();
    lecteur.onload = () => {
      try {
        const donnees = JSON.parse(String(lecteur.result));
        if (!donnees || typeof donnees !== "object" || !donnees.progres) {
          throw new Error("format invalide");
        }
        if (typeof donnees.niveau === "string") {
          localStorage.setItem("nexora_niveau", donnees.niveau);
        }
        for (const id of ORDRE) {
          const liste = donnees.progres[id];
          if (Array.isArray(liste)) {
            localStorage.setItem(`nexora_progres_${id}`, JSON.stringify(liste));
          }
        }
        retourSauvegarde.textContent = "Progression restaurée. La page va se recharger.";
        retourSauvegarde.className = "retour ok";
        setTimeout(() => location.reload(), 900);
      } catch {
        retourSauvegarde.textContent = "Ce fichier ne ressemble pas à une sauvegarde Nexora valide.";
        retourSauvegarde.className = "retour ko";
      }
    };
    lecteur.readAsText(fichier);
  });
</script>
