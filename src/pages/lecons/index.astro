---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;

const niveaux = [
  { id: "debutant", glyphe: ">", nom: "Débutant", desc: "Afficher un message, utiliser des variables.", href: `${base}lecons/debutant/`, pret: true },
  { id: "intermediaire", glyphe: ">_", nom: "Intermédiaire", desc: "Conditions, boucles, logique de base.", href: null, pret: false },
  { id: "confirme", glyphe: "{ }", nom: "Confirmé", desc: "Fonctions, listes, dictionnaires, fichiers.", href: null, pret: false },
  { id: "expert", glyphe: "#!", nom: "Expert", desc: "Classes, exceptions, modules, puis le web statique.", href: null, pret: false },
];
---
<Base title="Nexora — Exercices">
  <span class="commentaire">parcours</span>
  <h1>Les exercices</h1>
  <p class="lede">Pas de longs cours à lire : chaque notion tient en quelques phrases, suivies d'un exercice. Quatre niveaux, dans l'ordre.</p>

  <div class="grille-niveaux" id="niveaux">
    {niveaux.map((n) => (
      n.pret ? (
        <a class="carte-niveau" data-niveau={n.id} href={n.href}>
          <span class="glyphe">{n.glyphe}</span>
          <h3>{n.nom}</h3>
          <p>{n.desc}</p>
          <span class="suite">Commencer</span>
        </a>
      ) : (
        <div class="carte-niveau verrouille" data-niveau={n.id}>
          <span class="glyphe">{n.glyphe}</span>
          <h3>{n.nom}</h3>
          <p>{n.desc}</p>
          <span class="suite">Bientôt</span>
        </div>
      )
    ))}
  </div>
</Base>

<script>
  const niveau = localStorage.getItem("nexora_niveau");
  if (niveau) {
    const carte = document.querySelector(`.carte-niveau[data-niveau="${niveau}"]`);
    if (carte) {
      carte.classList.add("actif");
      const pastille = document.createElement("span");
      pastille.className = "pastille";
      pastille.textContent = "ton niveau";
      carte.appendChild(pastille);
    }
  }
</script>
