---
import Base from "../../layouts/Base.astro";
const base = import.meta.env.BASE_URL;

const niveaux = [
  { id: "debutant", num: "01", nom: "Débutant", desc: "Afficher un message, utiliser des variables.", href: `${base}lecons/debutant/variables/`, pret: true },
  { id: "intermediaire", num: "02", nom: "Intermédiaire", desc: "Conditions, boucles, logique de base.", href: null, pret: false },
  { id: "confirme", num: "03", nom: "Confirmé", desc: "Fonctions, listes, dictionnaires, fichiers.", href: null, pret: false },
  { id: "expert", num: "04", nom: "Expert", desc: "Classes, exceptions, modules, puis le web statique.", href: null, pret: false },
];
---
<Base title="Nexora — Leçons">
  <span class="commentaire">parcours</span>
  <h1>Les leçons</h1>
  <p class="lede">Des séances de 5 à 10 minutes, du premier print() jusqu'au site publié. Quatre niveaux, dans l'ordre.</p>

  <div class="grille-niveaux" id="niveaux">
    {niveaux.map((n) => (
      n.pret ? (
        <a class="carte-niveau" data-niveau={n.id} href={n.href}>
          <span class="num-niveau">{n.num}</span>
          <h3>{n.nom}</h3>
          <p>{n.desc}</p>
        </a>
      ) : (
        <div class="carte-niveau" data-niveau={n.id} style="opacity: 0.6;">
          <span class="num-niveau">{n.num}</span>
          <h3>{n.nom}</h3>
          <p>{n.desc} — bientôt.</p>
        </div>
      )
    ))}
  </div>
</Base>

<script>
  const niveau = localStorage.getItem("nexora_niveau");
  if (niveau) {
    const carte = document.querySelector(`.carte-niveau[data-niveau="${niveau}"]`);
    if (carte) {
      carte.classList.add("actif");
      const pastille = document.createElement("span");
      pastille.className = "pastille";
      pastille.textContent = "ton niveau";
      carte.appendChild(pastille);
    }
  }
</script>
