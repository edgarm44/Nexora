---
import Base from "../../../layouts/Base.astro";
---
<Base title="Nexora — Intermédiaire">
  <span class="commentaire">intermédiaire</span>
  <h1>Décider et répéter</h1>
  <p class="lede">Cinq petites notions, une par une : des conditions, puis des boucles.</p>

  <div class="carte" id="exo-card">
    <div class="progression" id="exo-progress"></div>
    <div id="exo-body"></div>
  </div>
</Base>

<script>
  type TypeExercice = "qcm" | "completer" | "ecrire";

  interface Unite {
    id: string;
    titre: string;
    explication: string;
    exemple: string[];
    consigne: string;
    code?: string[];
    type: TypeExercice;
    options?: string[];
    bonneOption?: number;
    reponsesValides?: RegExp;
    placeholder?: string;
    indiceErreur?: string;
  }

  const UNITES: Unite[] = [
    {
      id: "u1",
      titre: "Comparer deux valeurs",
      explication:
        'Python sait comparer : <code>&gt;</code> (plus grand), <code>&lt;</code> (plus petit), <code>==</code> (égal à). Le résultat est True ou False.',
      exemple: ["x = 10", "print(x > 5)"],
      consigne: "Que va afficher ce programme ?",
      code: ["age = 12", "print(age == 13)"],
      type: "qcm",
      options: ["True", "False", "12", "Une erreur"],
      bonneOption: 1,
    },
    {
      id: "u2",
      titre: "if / else : décider",
      explication:
        "Le bloc if ne s'exécute que si la condition est vraie. Sinon, c'est le bloc else qui s'exécute. L'indentation (les espaces au début de la ligne) indique ce qui appartient à chaque bloc.",
      exemple: ['x = 7\nif x > 5:\n    print("grand")\nelse:\n    print("petit")'],
      consigne: "Que va afficher ce programme ?",
      code: ['note = 8\nif note >= 10:\n    print("admis")\nelse:\n    print("recale")'],
      type: "qcm",
      options: ["admis", "recale", "Une erreur", "Rien"],
      bonneOption: 1,
    },
    {
      id: "u3",
      titre: "Compléter une condition",
      explication:
        "Une condition s'écrit toujours entre if et le double-point :. On peut combiner plusieurs comparaisons avec and (et) ou or (ou).",
      exemple: ['temperature = 28\nif temperature > 25:\n    print("il fait chaud")'],
      consigne: "Complète la condition pour que le programme affiche majeur quand age vaut 18 ou plus.",
      code: ["age = 18", "if ____________:", '    print("majeur")'],
      type: "completer",
      reponsesValides: /^age\s*>=\s*18$/,
      placeholder: "age >= 18",
      indiceErreur: "Utilise l'opérateur >= (supérieur ou égal) entre age et 18.",
    },
    {
      id: "u4",
      titre: "La boucle for : répéter un nombre de fois connu",
      explication:
        "range(3) donne les nombres 0, 1 et 2 : Python commence à compter à 0. La boucle for répète son bloc pour chaque valeur.",
      exemple: ["for i in range(3):\n    print(i)"],
      consigne: "Que va afficher ce programme ?",
      code: ["for i in range(4):\n    print(i)"],
      type: "qcm",
      options: ["1 2 3 4", "0 1 2 3", "0 1 2 3 4", "4"],
      bonneOption: 1,
    },
    {
      id: "u5",
      titre: "Écrire une boucle",
      explication:
        "Pour afficher une suite de nombres, on écrit for, un nom de variable, in range(...), puis un double-point, et on indente la ligne suivante.",
      exemple: ["for i in range(2):\n    print(i)"],
      consigne: "Écris une boucle for qui affiche print(i) pour i allant de 0 à 4 inclus (5 tours).",
      type: "ecrire",
      reponsesValides: /^for\s+i\s+in\s+range\(5\)\s*:$/,
      placeholder: "for i in range(5):",
      indiceErreur: "Pense à range(5) pour obtenir 5 tours (0, 1, 2, 3, 4), et au double-point à la fin.",
    },
  ];

  const base = import.meta.env.BASE_URL;
  const body = document.getElementById("exo-body")!;
  const progress = document.getElementById("exo-progress")!;
  const CLE_PROGRES = "nexora_progres_intermediaire";

  let current = 0;

  function progresActuel(): string[] {
    try {
      return JSON.parse(localStorage.getItem(CLE_PROGRES) ?? "[]");
    } catch {
      return [];
    }
  }

  function marquerTermine(id: string) {
    const fait = progresActuel();
    if (!fait.includes(id)) {
      fait.push(id);
      localStorage.setItem(CLE_PROGRES, JSON.stringify(fait));
    }
  }

  function renderProgress() {
    progress.innerHTML = "";
    for (let i = 0; i < UNITES.length; i++) {
      const span = document.createElement("span");
      if (i < current) span.className = "fait";
      else if (i === current) span.className = "courant";
      progress.appendChild(span);
    }
  }

  function blocCode(blocs: string[]) {
    return blocs
      .map((bloc) => {
        const lignes = bloc.split("\n");
        return `
          <div class="terminal" style="margin-bottom: 1.25rem;">
            <div class="terminal-barre"><span>python</span></div>
            <div class="terminal-corps">
              ${lignes
                .map(
                  (l, i) =>
                    `<div class="terminal-ligne"><span class="num">${i + 1}</span><span>${l.replace(/</g, "&lt;")}</span></div>`
                )
                .join("")}
            </div>
          </div>
        `;
      })
      .join("");
  }

  function avancer() {
    current++;
    if (current >= UNITES.length) {
      renderFin();
    } else {
      renderProgress();
      renderUnite(UNITES[current]);
    }
  }

  function renderFin() {
    progress.innerHTML = "";
    body.innerHTML = `
      <div class="resultat">
        <span class="commentaire">bravo</span>
        <h2>Niveau intermédiaire terminé</h2>
        <p style="color: var(--ink-dim);">Les cinq exercices sont faits. Le niveau suivant arrive bientôt.</p>
        <div class="actions"><a class="btn" href="${base}lecons/">Retour aux niveaux</a></div>
      </div>
    `;
  }

  function renderUnite(u: Unite) {
    body.innerHTML = `
      <span class="commentaire">${current + 1} sur ${UNITES.length} · ${u.titre}</span>
      <p class="explication" style="margin-top: 0.4rem;">${u.explication}</p>
      ${blocCode(u.exemple)}
      <p class="consigne">${u.consigne}</p>
      ${u.code ? blocCode(u.code) : ""}
      <div id="zone-exercice"></div>
      <div id="zone-suite"></div>
    `;

    const zone = document.getElementById("zone-exercice")!;
    const suite = document.getElementById("zone-suite")!;

    function proposerSuite(reussi: boolean) {
      if (reussi) marquerTermine(u.id);
      suite.innerHTML = `
        <div class="actions" style="margin-top: 1.25rem;">
          <button class="btn" id="btn-suivant" type="button">${current === UNITES.length - 1 ? "Terminer" : "Exercice suivant"}</button>
        </div>
      `;
      document.getElementById("btn-suivant")!.addEventListener("click", avancer);
    }

    if (u.type === "qcm") {
      zone.innerHTML = `
        <div class="options">
          ${u.options!.map((opt, i) => `<button class="option" data-index="${i}">${opt}</button>`).join("")}
        </div>
      `;
      const boutons = zone.querySelectorAll<HTMLButtonElement>(".option");
      boutons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const choisi = Number(btn.dataset.index);
          boutons.forEach((b) => (b.disabled = true));
          const correct = choisi === u.bonneOption;
          if (correct) {
            btn.classList.add("bonne");
          } else {
            btn.classList.add("mauvaise");
            boutons[u.bonneOption!].classList.add("bonne");
          }
          proposerSuite(correct);
        });
      });
    } else {
      zone.innerHTML = `
        <input class="champ-reponse" id="champ" type="text" placeholder="${u.placeholder ?? ""}" autocomplete="off" />
        <div class="actions" style="margin-top: 0.9rem;"><button class="btn-ghost" id="btn-verifier" type="button">Vérifier</button></div>
        <p class="retour" id="retour"></p>
      `;
      const champ = document.getElementById("champ") as HTMLInputElement;
      const retour = document.getElementById("retour")!;

      function verifier() {
        const val = champ.value.trim().replace(/\s+/g, " ").replace(/'/g, '"');
        const ok = u.reponsesValides!.test(val);
        if (ok) {
          retour.textContent = "C'est exact.";
          retour.className = "retour ok";
          champ.disabled = true;
          document.getElementById("btn-verifier")!.setAttribute("disabled", "true");
          proposerSuite(true);
        } else {
          retour.textContent = u.indiceErreur ?? "Essaie encore.";
          retour.className = "retour ko";
        }
      }

      document.getElementById("btn-verifier")!.addEventListener("click", verifier);
      champ.addEventListener("keydown", (e) => {
        if (e.key === "Enter") verifier();
      });
    }
  }

  const fait = progresActuel();
  const premierNonFait = UNITES.findIndex((u) => !fait.includes(u.id));
  current = premierNonFait === -1 ? UNITES.length : premierNonFait;

  if (current >= UNITES.length) {
    renderFin();
  } else {
    renderProgress();
    renderUnite(UNITES[current]);
  }
</script>
