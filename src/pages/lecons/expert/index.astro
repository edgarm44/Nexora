---
import Base from "../../../layouts/Base.astro";
---
<Base title="Nexora — Expert">
  <span class="commentaire">expert</span>
  <h1>Classes, erreurs et modules</h1>
  <p class="lede">Dix notions, pour boucler les bases de Python avant de passer au web.</p>

  <div class="carte" id="exo-card">
    <div class="progression" id="exo-progress"></div>
    <div id="exo-body"></div>
  </div>
</Base>

<script>
  import { initExercices, type Unite } from "../../../lib/exercices";

  const UNITES: Unite[] = [
    {
      id: "u1",
      titre: "Gérer une erreur avec try / except",
      explication:
        "Diviser par zéro, convertir un texte invalide en nombre : certaines erreurs sont prévisibles. try exécute le code risqué ; si une erreur du type attendu survient, except prend le relais au lieu de faire planter tout le programme.",
      exemple: ['try:\n    x = 10 / 0\nexcept ZeroDivisionError:\n    print("Impossible de diviser par zéro")'],
      consigne: "Que va afficher ce programme ?",
      code: ['try:\n    nombre = int("abc")\nexcept ValueError:\n    print("Ce n\'est pas un nombre")'],
      type: "qcm",
      options: ["abc", "Ce n'est pas un nombre", "Une erreur qui arrête le programme", "Rien"],
      bonneOption: 1,
      explicationReponse: 'int("abc") déclenche une ValueError car "abc" n\'est pas un nombre valide ; except ValueError l\'intercepte et exécute son print au lieu de planter.',
    },
    {
      id: "u2",
      titre: "Écrire son propre try / except",
      explication:
        "On place le code qui peut échouer entre try et except. Le mot-clé après except précise quel type d'erreur on attend — s'il n'y a pas d'erreur, ou une erreur d'un autre type, except ne se déclenche pas.",
      exemple: ['try:\n    print(1 / 0)\nexcept ZeroDivisionError:\n    print("division impossible")'],
      consigne: 'Complète pour que le programme affiche "trop grand" si on accède à un indice qui n\'existe pas dans la liste.',
      type: "code",
      codeDepart: 'liste = [1, 2, 3]\ntry:\n    print(liste[10])\nexcept ____________:\n    print("trop grand")',
      sortieAttendue: /^trop grand$/,
      indiceCode: "L'erreur levée quand un indice de liste n'existe pas s'appelle IndexError.",
      explicationReponse: "liste[10] n'existe pas (la liste n'a que 3 éléments) : Python lève une IndexError, que except IndexError intercepte.",
    },
    {
      id: "u3",
      titre: "Une classe fabrique des objets",
      explication:
        "class définit un modèle. __init__ est appelée automatiquement à la création d'un objet et initialise ses attributs. self désigne l'objet lui-même — c'est ce qui permet à chaque objet créé à partir de la classe d'avoir ses propres valeurs.",
      exemple: [
        "class Personnage:\n    def __init__(self, nom, pv):\n        self.nom = nom\n        self.pv = pv",
        'heros = Personnage("Léa", 100)\nprint(heros.nom)',
      ],
      consigne: "Que va afficher ce programme ?",
      code: ['class Chien:\n    def __init__(self, nom):\n        self.nom = nom\n\nrex = Chien("Rex")\nprint(rex.nom)'],
      type: "qcm",
      options: ["Chien", "rex", "Rex", "Une erreur"],
      bonneOption: 2,
      explicationReponse: 'Chien("Rex") appelle __init__ avec nom = "Rex", qui range cette valeur dans self.nom : rex.nom vaut donc "Rex".',
    },
    {
      id: "u4",
      titre: "Créer et utiliser un objet, pour de vrai",
      explication:
        "Dans ce terminal, écris une vraie classe et crée un objet à partir d'elle, comme dans l'exemple ci-dessus.",
      exemple: ["class Personnage:\n    def __init__(self, nom, pv):\n        self.nom = nom\n        self.pv = pv"],
      consigne: "Complète la classe Compte pour qu'elle stocke un solde, puis affiche le solde d'un compte créé avec 50.",
      type: "code",
      codeDepart: "class Compte:\n    def __init__(self, solde):\n        self.solde = ____\n\nmon_compte = Compte(50)\nprint(mon_compte.solde)",
      sortieAttendue: /^50$/,
      indiceCode: "self.solde doit recevoir le paramètre solde reçu par __init__.",
      explicationReponse: "self.solde = solde stocke la valeur reçue (50) comme attribut de l'objet ; mon_compte.solde va ensuite la relire.",
    },
    {
      id: "u5",
      titre: "import : réutiliser du code déjà écrit",
      explication:
        "Python fournit des modules tout prêts. import rend leurs fonctions disponibles, avec un point entre le nom du module et la fonction. Pas besoin de réinventer ce que d'autres ont déjà écrit et testé.",
      exemple: ["import math\nprint(math.sqrt(16))"],
      consigne: "Que va afficher ce programme ?",
      code: ["import random\nnombres = [1, 2, 3]\nprint(len(nombres))"],
      type: "qcm",
      options: ["1", "2", "3", "Une erreur"],
      bonneOption: 2,
      explicationReponse: "import random rend le module disponible mais len(nombres) ne dépend pas de lui : la liste a 3 éléments, donc len() renvoie 3.",
    },
    {
      id: "u6",
      titre: "Déclencher sa propre erreur avec raise",
      explication:
        "On peut aussi déclencher soi-même une erreur avec raise, par exemple pour signaler qu'une valeur reçue n'est pas valide, plutôt que de laisser le programme continuer avec une donnée incorrecte.",
      exemple: ['def verifier_age(age):\n    if age < 0:\n        raise ValueError("âge invalide")\n    return age'],
      consigne: "Que va afficher ce programme ?",
      code: ['try:\n    raise ValueError("stop")\nexcept ValueError as erreur:\n    print("erreur attrapée :", erreur)'],
      type: "qcm",
      options: ["stop", "erreur attrapée : stop", "Une erreur qui arrête le programme", "Rien"],
      bonneOption: 1,
      explicationReponse: 'raise ValueError("stop") déclenche l\'erreur, except ValueError as erreur l\'attrape et range son message ("stop") dans erreur, affiché ensuite.',
    },
    {
      id: "u7",
      titre: "Une méthode, en plus de __init__",
      explication:
        "Une classe peut avoir d'autres méthodes que __init__, qui agissent sur l'objet via self. C'est ce qui permet à un objet de faire quelque chose, pas seulement de stocker des données.",
      exemple: ["class Personnage:\n    def __init__(self, pv):\n        self.pv = pv\n\n    def subir_degats(self, degats):\n        self.pv = self.pv - degats"],
      consigne: "Ajoute une méthode soigner à la classe, qui augmente pv de 10, puis affiche le pv après avoir soigné un personnage créé avec 50 pv.",
      type: "code",
      codeDepart: "class Personnage:\n    def __init__(self, pv):\n        self.pv = pv\n\n    def soigner(self):\n        self.pv = ____________\n\nh = Personnage(50)\nh.soigner()\nprint(h.pv)",
      sortieAttendue: /^60$/,
      indiceCode: "self.pv = self.pv + 10 à l'intérieur de soigner.",
      explicationReponse: "soigner() ajoute 10 à self.pv : 50 + 10 = 60, et h.pv vaut 60 après l'appel.",
    },
    {
      id: "u8",
      titre: "HTML : la structure d'une page web",
      explication:
        "Une page HTML est faite de balises imbriquées. <html> contient tout, <body> contient ce qui s'affiche, et une balise comme <h1> ou <p> délimite un bloc de contenu.",
      exemple: ["<html>\n  <body>\n    <h1>Bonjour</h1>\n    <p>Ma première page</p>\n  </body>\n</html>"],
      consigne: "Laquelle de ces balises sert à afficher un titre principal ?",
      type: "qcm",
      options: ["<p>", "<h1>", "<div>", "<title>"],
      bonneOption: 1,
      explicationReponse: "<h1> est la balise de titre principal, la plus importante d'une page. <p> est pour un paragraphe, <div> pour une simple zone, <title> pour le titre de l'onglet du navigateur.",
    },
    {
      id: "u9",
      titre: "CSS : donner du style au HTML",
      explication:
        "CSS décrit l'apparence d'une page HTML : couleurs, tailles, espacements. Une règle CSS cible un élément (par exemple h1) et lui applique des propriétés entre accolades.",
      exemple: ["h1 {\n  color: blue;\n  font-size: 32px;\n}"],
      consigne: "Laquelle de ces règles CSS change la couleur du texte ?",
      type: "qcm",
      options: ["size: blue;", "color: blue;", "text: blue;", "font: blue;"],
      bonneOption: 1,
      explicationReponse: "La propriété CSS qui change la couleur du texte s'appelle color. size, text et font ne sont pas des propriétés CSS valides pour ça.",
    },
    {
      id: "u10",
      titre: "Une liste d'objets",
      explication:
        "On peut ranger plusieurs objets créés à partir d'une même classe dans une liste, puis les parcourir avec une boucle for, exactement comme pour des nombres ou du texte.",
      exemple: [
        'class Personnage:\n    def __init__(self, nom, pv):\n        self.nom = nom\n        self.pv = pv\n\nequipe = [Personnage("Léa", 100), Personnage("Sam", 80)]\nfor p in equipe:\n    print(p.nom)',
      ],
      consigne: "Complète pour créer deux Personnage (\"Léa\", 100) et (\"Sam\", 80) dans une liste equipe, puis affiche le nom de chacun avec une boucle.",
      code: [
        'class Personnage:\n    def __init__(self, nom, pv):\n        self.nom = nom\n        self.pv = pv\n\nequipe = [____________]\nfor p in equipe:\n    print(p.nom)',
      ],
      type: "code",
      codeDepart:
        'class Personnage:\n    def __init__(self, nom, pv):\n        self.nom = nom\n        self.pv = pv\n\nequipe = [____________]\nfor p in equipe:\n    print(p.nom)',
      sortieAttendue: /Léa\s*\n\s*Sam/,
      indiceCode: 'equipe = [Personnage("Léa", 100), Personnage("Sam", 80)]',
      explicationReponse: "La boucle parcourt chaque objet Personnage de la liste equipe, et p.nom affiche le nom de celui qui est en cours de traitement à chaque tour.",
    },
  ];

  initExercices({
    unites: UNITES,
    cleProgres: "nexora_progres_expert",
    corpsId: "exo-body",
    progressionId: "exo-progress",
    base: import.meta.env.BASE_URL,
    titreFin: "Les quatre premiers niveaux sont terminés",
    texteFin: "Tu as vu les bases de Python, jusqu'aux classes et aux erreurs, avec un aperçu du HTML et du CSS. Le niveau Maître vient de se débloquer.",
    retourHref: `${import.meta.env.BASE_URL}lecons/`,
  });
</script>
