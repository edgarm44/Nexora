---
import Base from "../../../layouts/Base.astro";
---
<Base title="Nexora — Débutant">
  <span class="commentaire">débutant</span>
  <h1>Afficher et ranger des valeurs</h1>
  <p class="lede">Quatre petites notions, une par une. Lis, essaie, et avance quand tu es prêt.</p>

  <div class="carte" id="exo-card">
    <div class="progression" id="exo-progress"></div>
    <div id="exo-body"></div>
  </div>
</Base>

<script>
  type TypeExercice = "qcm" | "completer" | "ecrire";

  interface Unite {
    id: string;
    titre: string;
    explication: string; // HTML
    exemple: string[]; // lignes de code de l'exemple
    consigne: string;
    code?: string[]; // lignes de code de la consigne, si besoin
    type: TypeExercice;
    options?: string[];
    bonneOption?: number;
    reponsesValides?: RegExp;
    placeholder?: string;
    indiceErreur?: string;
  }

  const UNITES: Unite[] = [
    {
      id: "u1",
      titre: "print() affiche quelque chose",
      explication:
        'La fonction <code>print()</code> affiche ce qu\'on met entre les parenthèses. Si c\'est du texte, il faut l\'entourer de guillemets.',
      exemple: ['print("Bonjour")'],
      consigne: "Que va afficher ce programme ?",
      code: ['print("Salut Nexora")'],
      type: "qcm",
      options: ["Salut Nexora", '"Salut Nexora"', "Une erreur"],
      bonneOption: 0,
    },
    {
      id: "u2",
      titre: "Une variable, une boîte",
      explication:
        'On range une valeur dans une variable avec le signe <code>=</code>. On peut ensuite la réutiliser, y compris dans un <code>print()</code>.',
      exemple: ['prenom = "Léa"', 'print("Bonjour", prenom)'],
      consigne: "Complète la ligne pour que le programme affiche : Bonjour Nexora",
      code: ["print(____________)"],
      type: "completer",
      reponsesValides: /^"Bonjour Nexora"$/,
      placeholder: 'ce qui va entre les parenthèses, ex : "mon texte"',
      indiceErreur: 'Il faut le texte exact entre guillemets, par exemple "Bonjour Nexora".',
    },
    {
      id: "u3",
      titre: "print() peut afficher plusieurs choses",
      explication:
        "Avec une virgule, print() affiche plusieurs éléments à la suite, séparés par un espace.",
      exemple: ["age = 12", 'print("J\'ai", age, "ans")'],
      consigne: "Que va afficher ce programme ?",
      code: ["taille = 150", 'print("Je mesure", taille, "cm")'],
      type: "qcm",
      options: ["taille cm", "Je mesure 150 cm", "Je mesure taille cm", "Une erreur"],
      bonneOption: 1,
    },
    {
      id: "u4",
      titre: "Les variables peuvent contenir des nombres",
      explication:
        "Avec des nombres, les opérateurs habituels fonctionnent : + - * /. Le résultat peut être rangé dans une nouvelle variable.",
      exemple: ["a = 2", "b = 5", "produit = a * b"],
      consigne: "Écris une ligne qui range la somme de 3 et 4 dans une variable appelée total.",
      type: "ecrire",
      reponsesValides: /^total\s*=\s*(3\s*\+\s*4|7)$/,
      placeholder: "total = ...",
      indiceErreur: "Le nom de la variable, le signe =, puis le calcul ou le résultat.",
    },
  ];

  const base = import.meta.env.BASE_URL;
  const body = document.getElementById("exo-body")!;
  const progress = document.getElementById("exo-progress")!;
  const CLE_PROGRES = "nexora_progres_debutant";

  let current = 0;

  function progresActuel(): string[] {
    try {
      return JSON.parse(localStorage.getItem(CLE_PROGRES) ?? "[]");
    } catch {
      return [];
    }
  }

  function marquerTermine(id: string) {
    const fait = progresActuel();
    if (!fait.includes(id)) {
      fait.push(id);
      localStorage.setItem(CLE_PROGRES, JSON.stringify(fait));
    }
  }

  function renderProgress() {
    progress.innerHTML = "";
    for (let i = 0; i < UNITES.length; i++) {
      const span = document.createElement("span");
      if (i < current) span.className = "fait";
      else if (i === current) span.className = "courant";
      progress.appendChild(span);
    }
  }

  function blocCode(lignes: string[]) {
    return `
      <div class="terminal" style="margin-bottom: 1.25rem;">
        <div class="terminal-barre"><span>python</span></div>
        <div class="terminal-corps">
          ${lignes
            .map(
              (l, i) =>
                `<div class="terminal-ligne"><span class="num">${i + 1}</span><span>${l.replace(/</g, "&lt;")}</span></div>`
            )
            .join("")}
        </div>
      </div>
    `;
  }

  function avancer() {
    current++;
    if (current >= UNITES.length) {
      renderFin();
    } else {
      renderProgress();
      renderUnite(UNITES[current]);
    }
  }

  function renderFin() {
    progress.innerHTML = "";
    body.innerHTML = `
      <div class="resultat">
        <span class="commentaire">bravo</span>
        <h2>Niveau débutant terminé</h2>
        <p style="color: var(--ink-dim);">Les quatre exercices sont faits. Le niveau suivant arrive bientôt.</p>
        <div class="actions"><a class="btn" href="${base}lecons/">Retour aux niveaux</a></div>
      </div>
    `;
  }

  function renderUnite(u: Unite) {
    body.innerHTML = `
      <span class="commentaire">${current + 1} sur ${UNITES.length} · ${u.titre}</span>
      <p class="explication" style="margin-top: 0.4rem;">${u.explication}</p>
      ${blocCode(u.exemple)}
      <p class="consigne">${u.consigne}</p>
      ${u.code ? blocCode(u.code) : ""}
      <div id="zone-exercice"></div>
      <div id="zone-suite"></div>
    `;

    const zone = document.getElementById("zone-exercice")!;
    const suite = document.getElementById("zone-suite")!;

    function proposerSuite(reussi: boolean) {
      if (reussi) marquerTermine(u.id);
      suite.innerHTML = `
        <div class="actions" style="margin-top: 1.25rem;">
          <button class="btn" id="btn-suivant" type="button">${current === UNITES.length - 1 ? "Terminer" : "Exercice suivant"}</button>
        </div>
      `;
      document.getElementById("btn-suivant")!.addEventListener("click", avancer);
    }

    if (u.type === "qcm") {
      zone.innerHTML = `
        <div class="options">
          ${u.options!.map((opt, i) => `<button class="option" data-index="${i}">${opt}</button>`).join("")}
        </div>
      `;
      const boutons = zone.querySelectorAll<HTMLButtonElement>(".option");
      boutons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const choisi = Number(btn.dataset.index);
          boutons.forEach((b) => (b.disabled = true));
          const correct = choisi === u.bonneOption;
          if (correct) {
            btn.classList.add("bonne");
          } else {
            btn.classList.add("mauvaise");
            boutons[u.bonneOption!].classList.add("bonne");
          }
          proposerSuite(correct);
        });
      });
    } else {
      // completer ou ecrire
      zone.innerHTML = `
        <input class="champ-reponse" id="champ" type="text" placeholder="${u.placeholder ?? ""}" autocomplete="off" />
        <div class="actions" style="margin-top: 0.9rem;"><button class="btn-ghost" id="btn-verifier" type="button">Vérifier</button></div>
        <p class="retour" id="retour"></p>
      `;
      const champ = document.getElementById("champ") as HTMLInputElement;
      const retour = document.getElementById("retour")!;

      function verifier() {
        const val = champ.value.trim().replace(/\s+/g, " ").replace(/'/g, '"');
        const ok = u.reponsesValides!.test(val);
        if (ok) {
          retour.textContent = "C'est exact.";
          retour.className = "retour ok";
          champ.disabled = true;
          document.getElementById("btn-verifier")!.setAttribute("disabled", "true");
          proposerSuite(true);
        } else {
          retour.textContent = u.indiceErreur ?? "Essaie encore.";
          retour.className = "retour ko";
        }
      }

      document.getElementById("btn-verifier")!.addEventListener("click", verifier);
      champ.addEventListener("keydown", (e) => {
        if (e.key === "Enter") verifier();
      });
    }
  }

  const fait = progresActuel();
  const premierNonFait = UNITES.findIndex((u) => !fait.includes(u.id));
  current = premierNonFait === -1 ? UNITES.length : premierNonFait;

  if (current >= UNITES.length) {
    renderFin();
  } else {
    renderProgress();
    renderUnite(UNITES[current]);
  }
</script>
