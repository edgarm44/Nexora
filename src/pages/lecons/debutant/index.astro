---
import Base from "../../../layouts/Base.astro";
---
<Base title="Nexora — Débutant">
  <span class="commentaire">débutant</span>
  <h1>Afficher et ranger des valeurs</h1>
  <p class="lede">Neuf petites notions, une par une. Lis, essaie, et avance quand tu es prêt.</p>

  <div class="carte" id="exo-card">
    <div class="progression" id="exo-progress"></div>
    <div id="exo-body"></div>
  </div>
</Base>

<script is:inline src="https://cdn.jsdelivr.net/pyodide/v0.27.6/full/pyodide.js"></script>
<script>
  import { initExercices, type Unite } from "../../../lib/exercices";

  const UNITES: Unite[] = [
    {
      id: "u1",
      titre: "print() affiche quelque chose",
      explication:
        "print() est la toute première commande qu'on apprend : elle demande à Python d'afficher quelque chose à l'écran. Ce qui est entre guillemets est du texte — sans les guillemets, Python chercherait une variable portant ce nom, et ne la trouvant pas, afficherait une erreur.",
      exemple: ['print("Bonjour")'],
      consigne: "Que va afficher ce programme ?",
      code: ['print("Salut Nexora")'],
      type: "qcm",
      options: ["Salut Nexora", '"Salut Nexora"', "Une erreur"],
      bonneOption: 0,
      explicationReponse: "Les guillemets ne font pas partie du texte affiché : ils servent seulement à dire à Python où le texte commence et se termine.",
    },
    {
      id: "u2",
      titre: "Une variable, une boîte avec une étiquette",
      explication:
        "On range une valeur dans une variable avec le signe =. L'intérêt : on peut la réutiliser sans la retaper, y compris dans un print(). C'est particulièrement utile dès qu'une valeur sert à plusieurs endroits du programme.",
      exemple: ['prenom = "Léa"', 'print("Bonjour", prenom)'],
      consigne: "Complète la ligne pour que le programme affiche : Bonjour Nexora",
      code: ["print(____________)"],
      type: "completer",
      reponsesValides: /^"Bonjour Nexora"$/,
      placeholder: 'ce qui va entre les parenthèses, ex : "mon texte"',
      indiceErreur: 'Il faut le texte exact entre guillemets, par exemple "Bonjour Nexora".',
      explicationReponse: 'print("Bonjour Nexora") affiche exactement ce qu\'il y a entre les guillemets, lettre pour lettre.',
    },
    {
      id: "u3",
      titre: "print() peut afficher plusieurs choses",
      explication:
        "Avec une virgule, print() affiche plusieurs éléments à la suite, séparés automatiquement par un espace. C'est différent du signe +, qu'on verra juste après.",
      exemple: ["age = 12", 'print("J\'ai", age, "ans")'],
      consigne: "Que va afficher ce programme ?",
      code: ["taille = 150", 'print("Je mesure", taille, "cm")'],
      type: "qcm",
      options: ["taille cm", "Je mesure 150 cm", "Je mesure taille cm", "Une erreur"],
      bonneOption: 1,
      explicationReponse: "Avec une virgule, print() affiche la valeur de la variable (150), pas son nom (taille). Un espace est ajouté automatiquement entre chaque élément.",
    },
    {
      id: "u4",
      titre: "Les variables peuvent contenir des nombres",
      explication:
        "Avec des nombres, les opérateurs habituels fonctionnent : + - * /. Le résultat peut être rangé dans une nouvelle variable, ce qui permet d'enchaîner des calculs sans tout retaper.",
      exemple: ["a = 2", "b = 5", "produit = a * b"],
      consigne: "Écris une ligne qui range la somme de 3 et 4 dans une variable appelée total.",
      type: "ecrire",
      reponsesValides: /^total\s*=\s*(3\s*\+\s*4|7)$/,
      placeholder: "total = ...",
      indiceErreur: "Le nom de la variable, le signe =, puis le calcul ou le résultat.",
      explicationReponse: "total = 3 + 4 range directement le résultat du calcul (7) dans la variable total, comme avec n'importe quel calcul.",
    },
    {
      id: "u5",
      titre: "Chaque valeur a un type",
      explication:
        "Du texte, un nombre entier, un nombre à virgule... chaque valeur a un type. str pour le texte (string), int pour un nombre entier. type() permet de vérifier le type d'une valeur — pratique quand un programme se comporte bizarrement.",
      exemple: ["age = 13", "print(type(age))"],
      consigne: "Que va afficher ce programme ?",
      code: ['nom = "Léa"', "print(type(nom))"],
      type: "qcm",
      options: ["<class 'str'>", "<class 'int'>", "Léa", "Une erreur"],
      bonneOption: 0,
      explicationReponse: "nom contient du texte entre guillemets, donc son type est str (pour string, « chaîne de caractères » en anglais).",
    },
    {
      id: "u6",
      titre: "Mélanger texte et nombre, ça ne marche pas tout seul",
      explication:
        "Avec +, Python refuse de coller directement du texte et un nombre : il faut d'abord transformer le nombre en texte avec str(). C'est une des erreurs les plus fréquentes au début — autant la connaître tout de suite pour ne plus y être surpris.",
      exemple: ["age = 13", 'print("J\'ai " + str(age) + " ans")'],
      consigne: "Pourquoi ce programme provoque-t-il une erreur ?",
      code: ["age = 13", 'print("J\'ai " + age + " ans")'],
      type: "qcm",
      options: [
        "Il manque un print",
        "On ne peut pas additionner du texte et un nombre avec +",
        "age n'existe pas",
        "Il ne provoque pas d'erreur",
      ],
      bonneOption: 1,
      explicationReponse: "age est un nombre (int) et \"J'ai \" est du texte (str). Python refuse de les coller avec + tant que l'un des deux n'a pas été converti, avec str(age) par exemple.",
    },
    {
      id: "u7",
      titre: "À toi de jouer, dans un vrai terminal",
      explication:
        "Ici, le code que tu écris est vraiment exécuté par Python, dans ton navigateur. Pas de piège : juste une variable et un calcul, comme dans l'unité précédente.",
      exemple: ["a = 10", "b = 5", "resultat = a - b"],
      consigne: "Calcule la somme de 15 et 27, range-la dans une variable total, puis affiche-la avec print(total).",
      type: "code",
      codeDepart: "____________\nprint(total)",
      sortieAttendue: /^42$/,
      indiceCode: "Il faut une ligne du type total = 15 + 27 avant le print(total).",
      explicationReponse: "total = 15 + 27 calcule 42 et le range dans total ; print(total) affiche ensuite cette valeur, pas le texte \"total\".",
    },
    {
      id: "u8",
      titre: "Les commentaires, des notes pour les humains",
      explication:
        "Une ligne qui commence par # est un commentaire : Python l'ignore complètement lors de l'exécution. Ça sert à expliquer son propre code, pour soi-même ou pour quelqu'un qui le lira plus tard.",
      exemple: ["# Ceci calcule l'âge dans 10 ans\nage = 13\nprint(age + 10)"],
      consigne: "Que va afficher ce programme ?",
      code: ["# affiche un message de bienvenue", 'print("Bienvenue")'],
      type: "qcm",
      options: ["# affiche un message de bienvenue", "Bienvenue", "Rien du tout", "Une erreur"],
      bonneOption: 1,
      explicationReponse: "La ligne qui commence par # est entièrement ignorée par Python : seul le print(\"Bienvenue\") est réellement exécuté.",
    },
    {
      id: "u9",
      titre: "Comparer deux valeurs : True ou False",
      explication:
        "Avec ==, <, > ou >=, Python compare deux valeurs et répond toujours par True (vrai) ou False (faux). C'est la base de toutes les décisions qu'un programme peut prendre.",
      exemple: ["age = 13", "print(age == 13)", "print(age > 18)"],
      consigne: "Que va afficher print(10 > 7) ?",
      code: ["print(10 > 7)"],
      type: "qcm",
      options: ["10", "7", "True", "False"],
      bonneOption: 2,
      explicationReponse: "10 est bien plus grand que 7, donc la comparaison 10 > 7 est vraie : Python affiche True, pas les nombres eux-mêmes.",
    },
  ];

  initExercices({
    unites: UNITES,
    cleProgres: "nexora_progres_debutant",
    corpsId: "exo-body",
    progressionId: "exo-progress",
    base: import.meta.env.BASE_URL,
    titreFin: "Niveau débutant terminé",
    texteFin: "Les neuf exercices sont faits. Le niveau intermédiaire vient de se débloquer.",
    retourHref: `${import.meta.env.BASE_URL}lecons/`,
  });
</script>
