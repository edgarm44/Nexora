---
const {
  title = "Nexora",
  description = "Nexora : apprendre Python à partir de zéro, gratuitement et sans compte obligatoire. Des leçons courtes suivies d'exercices interactifs, pour progresser à son rythme.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const urlCanonique = new URL(path, Astro.site).toString();

const onglets = [
  { href: base, label: "accueil.py", match: base },
  { href: `${base}lecons/`, label: "lecons.py", match: `${base}lecons` },
  { href: `${base}compte/`, label: "compte.py", match: `${base}compte` },
  { href: `${base}idees/`, label: "idees.py", match: `${base}idees` },
];

function estActif(match: string) {
  if (match === base) return path === base;
  return path.startsWith(match);
}
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Sora:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <header>
      <div class="barre-titre">
        <span class="feu"></span>
        <span class="feu"></span>
        <span class="feu"></span>
        <span class="chemin">~/nexora</span>
        <a class="profil-barre" id="profil-barre" href={`${base}compte/`} style="display: none;">
          <span class="avatar avatar-mini" id="profil-avatar"></span>
          <span id="profil-pseudo"></span>
        </a>
      </div>
      <nav class="onglets">
        {onglets.map((o) => (
          <a href={o.href} class="onglet" aria-current={estActif(o.match) ? "page" : undefined}>
            {o.label}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      try {
        const pseudo = localStorage.getItem("nexora_pseudo");
        if (pseudo) {
          const GLYPHES: Record<string, string> = {
            debutant: ">",
            intermediaire: ">_",
            confirme: "{ }",
            expert: "#!",
            web: "</>",
            algorithmes: "ƒ(x)",
            donnees: "{...}",
            projet: "*",
          };
          const personnage = localStorage.getItem("nexora_personnage") || "debutant";
          const barre = document.getElementById("profil-barre");
          const avatar = document.getElementById("profil-avatar");
          const nomPseudo = document.getElementById("profil-pseudo");
          if (barre && avatar && nomPseudo) {
            avatar.textContent = GLYPHES[personnage] ?? ">";
            avatar.className = `avatar avatar-mini avatar-${personnage}`;
            nomPseudo.textContent = pseudo;
            (barre as HTMLElement).style.display = "flex";
          }
        }
      } catch {
        // pas grave : le badge de profil est juste decoratif
      }
    </script>
    <footer>
      <p>Nexora — un projet pour apprendre Python, une ligne à la fois.</p>
    </footer>
  </body>
</html>
